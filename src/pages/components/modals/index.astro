---
import DocsLayout from '../../../layouts/DocsLayout.astro'
import DocsArticle from '../../../components/DocsArticle.astro'
import DocsExample from '../../../components/DocsExample.astro'
import CodeBlock from '../../../components/CodeBlock.astro'


---

<DocsLayout title="Modals — Karibase">
<DocsArticle
    title="Modals"
    lead="Dialog boxes for user interactions"
    breadcrumb={[{ name: 'Components', path: '/components' }, { name: 'Modals' }]}
    prev={{ name: 'Navigation', path: '/components/navigation' }}
    next={{ name: 'Alerts', path: '/components/alerts' }}
  >

    <h2 class="docs-heading docs-heading-2" id="basic-modal">Basic Modal</h2>
    <p class="docs-text">A simple modal dialog:</p>

    <div class="docs-preview">
      <button class="kb-btn kb-btn-primary" data-kb-show="showModal">Open Modal</button>

      <div class="kb-modal-overlay" data-kb-target="showModal" hidden data-kb-hide="showModal" data-kb-close>
        <div class="kb-modal">
          <div class="kb-modal-header">
            <h3 class="kb-modal-title">Modal Title</h3>
            <button class="kb-modal-close" data-kb-hide="showModal" data-kb-close>
              <i class="fas fa-times"></i>
            </button>
          </div>
          <div class="kb-modal-body">
            <p>This is the modal content. You can put any content here.</p>
          </div>
          <div class="kb-modal-footer">
            <button class="kb-btn kb-btn-secondary" data-kb-hide="showModal" data-kb-close>Cancel</button>
            <button class="kb-btn kb-btn-primary" data-kb-hide="showModal" data-kb-close>Confirm</button>
          </div>
        </div>
      </div>
    </div>

    <CodeBlock code={`<div class="kb-modal-overlay">
  <div class="kb-modal">
    <div class="kb-modal-header">
      <h3 class="kb-modal-title">Modal Title</h3>
      <button class="kb-modal-close"></button>
    </div>
    <div class="kb-modal-body">
      <p>Modal content</p>
    </div>
    <div class="kb-modal-footer">
      <button class="kb-btn kb-btn-secondary">Cancel</button>
      <button class="kb-btn kb-btn-primary">Confirm</button>
    </div>
  </div>
</div>`} />

    <h2 class="docs-heading docs-heading-2" id="modal-sizes">Modal Sizes</h2>
    <p class="docs-text">Modals in different sizes:</p>

    <DocsExample>
      <button class="kb-btn kb-btn-primary" data-kb-show="showSmallModal">Small</button>
    <CodeBlock slot="code" code={`<div class="kb-modal kb-modal-sm">...</div>`} /></DocsExample>

    <h2 class="docs-heading docs-heading-2" id="modal-with-form">Modal with Form</h2>
    <p class="docs-text">Modal containing a form with validation:</p>

    <div class="docs-preview">
      <button class="kb-btn kb-btn-primary" data-kb-show="showFormModal">Open Form Modal</button>

      <div class="kb-modal-overlay" data-kb-target="showFormModal" hidden data-kb-hide="showFormModal" data-kb-close>
        <div class="kb-modal kb-modal-lg">
          <div class="kb-modal-header">
            <h3 class="kb-modal-title">Create User</h3>
            <button class="kb-modal-close" data-kb-hide="showFormModal" data-kb-close>
              <i class="fas fa-times"></i>
            </button>
          </div>
          <div class="kb-modal-body">
            <form data-modal-form novalidate>
              <div class="kb-form-group">
                <label for="modalName" class="kb-label">Name</label>
                <input
                  type="text"
                  class="kb-input"
                  id="modalName"
                  name="name"
                  data-validate="name"
                  required
                >
                <div class="kb-valid-feedback" data-valid-for="name" hidden>Looks good!</div>
                <div class="kb-invalid-feedback" data-invalid-for="name" hidden></div>
              </div>
              <div class="kb-form-group">
                <label for="modalEmail" class="kb-label">Email</label>
                <input
                  type="email"
                  class="kb-input"
                  id="modalEmail"
                  name="email"
                  data-validate="email"
                  required
                >
                <div class="kb-valid-feedback" data-valid-for="email" hidden>Valid email!</div>
                <div class="kb-invalid-feedback" data-invalid-for="email" hidden></div>
              </div>
            </form>
          </div>
          <div class="kb-modal-footer">
            <button class="kb-btn kb-btn-secondary" data-kb-hide="showFormModal" data-kb-close>Cancel</button>
            <button class="kb-btn kb-btn-primary" data-modal-submit>Save</button>
          </div>
        </div>
      </div>
    </div>

    <CodeBlock title="HTML" code={`<div class="kb-modal-overlay" v-if="showFormModal">
  <div class="kb-modal kb-modal-lg" @click.stop>
    <div class="kb-modal-header">
      <h3 class="kb-modal-title">Create User</h3>
      <button class="kb-modal-close" @click="showFormModal = false"></button>
    </div>
    <div class="kb-modal-body">
      <form @submit.prevent="submitModalForm">
        <!-- Form fields -->
      </form>
    </div>
    <div class="kb-modal-footer">
      <button class="kb-btn kb-btn-secondary" @click="showFormModal = false">Cancel</button>
      <button class="kb-btn kb-btn-primary" @click="submitModalForm">Save</button>
    </div>
  </div>
</div>`} />
    <CodeBlock title="JavaScript" code={`import { ref, reactive } from 'vue'

export default {
  setup() {
    const showFormModal = ref(false)
    const modalForm = reactive({
      name: '',
      email: ''
    })

    const modalValidation = reactive({
      name: { valid: false, invalid: false, message: '' },
      email: { valid: false, invalid: false, message: '' }
    })

    const validateModalField = (field) => {
      switch(field) {
        case 'name':
          if (modalForm.name.length < 2) {
            modalValidation.name.valid = false
            modalValidation.name.invalid = true
            modalValidation.name.message = 'Name must be at least 2 characters'
          } else {
            modalValidation.name.valid = true
            modalValidation.name.invalid = false
            modalValidation.name.message = ''
          }
          break
        case 'email':
          const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/
          if (!emailRegex.test(modalForm.email)) {
            modalValidation.email.valid = false
            modalValidation.email.invalid = true
            modalValidation.email.message = 'Please enter a valid email'
          } else {
            modalValidation.email.valid = true
            modalValidation.email.invalid = false
            modalValidation.email.message = ''
          }
          break
      }
    }

    const submitModalForm = () => {
      validateModalField('name')
      validateModalField('email')

      const isValid = Object.values(modalValidation).every(v => v.valid)

      if (isValid) {
        alert('User created successfully!')
        showFormModal.value = false
        modalForm.name = ''
        modalForm.email = ''
        modalValidation.name = { valid: false, invalid: false, message: '' }
        modalValidation.email = { valid: false, invalid: false, message: '' }
      }
    }

    return {
      showFormModal,
      modalForm,
      modalValidation,
      validateModalField,
      submitModalForm
    }
  }
}`} />

  </DocsArticle>
</DocsLayout>
<style>

.kb-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.kb-modal {
  background-color: var(--docs-bg-primary);
  border-radius: 12px;
  box-shadow: var(--docs-shadow-lg);
  max-width: 500px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
}

.kb-modal-sm {
  max-width: 300px;
}

.kb-modal-md {
  max-width: 500px;
}

.kb-modal-lg {
  max-width: 800px;
}

.kb-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--docs-border-color);
}

.kb-modal-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--docs-text-primary);
  margin: 0;
}

.kb-modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: transparent;
  border: none;
  color: var(--docs-text-secondary);
  cursor: pointer;
  border-radius: 6px;
  transition: var(--docs-transition);
}

.kb-modal-close:hover {
  background-color: var(--docs-bg-tertiary);
  color: var(--docs-text-primary);
}

.kb-modal-body {
  padding: 20px;
}

.kb-modal-body p {
  color: var(--docs-text-secondary);
  margin: 0;
}

.kb-modal-footer {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  padding: 16px 20px;
  border-top: 1px solid var(--docs-border-color);
}
</style>

<script>
  const overlay = document.querySelector('[data-kb-target="showFormModal"]')
  const fields = overlay?.querySelectorAll('[data-validate]') ?? []

  const setState = (field, state, message = '') => {
    const input = overlay.querySelector(`[data-validate="${field}"]`)
    const valid = overlay.querySelector(`[data-valid-for="${field}"]`)
    const invalid = overlay.querySelector(`[data-invalid-for="${field}"]`)
    input.classList.toggle('kb-is-valid', state === 'valid')
    input.classList.toggle('kb-is-invalid', state === 'invalid')
    if (valid) valid.hidden = state !== 'valid'
    if (invalid) {
      invalid.hidden = state !== 'invalid'
      invalid.textContent = message
    }
    return state === 'valid'
  }

  const validate = (field) => {
    const value = overlay.querySelector(`[data-validate="${field}"]`).value
    if (field === 'name') {
      return value.length < 2
        ? setState('name', 'invalid', 'Name must be at least 2 characters')
        : setState('name', 'valid')
    }
    if (field === 'email') {
      return !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
        ? setState('email', 'invalid', 'Please enter a valid email')
        : setState('email', 'valid')
    }
  }

  fields.forEach((input) => {
    input.addEventListener('blur', () => validate(input.dataset.validate))
  })

  const submit = () => {
    const ok = [...fields].map((i) => validate(i.dataset.validate)).every(Boolean)
    if (ok) {
      alert('User created successfully!')
      overlay.hidden = true
      fields.forEach((i) => {
        i.value = ''
        setState(i.dataset.validate, 'none')
      })
    }
  }

  overlay?.querySelector('[data-modal-form]')?.addEventListener('submit', (e) => {
    e.preventDefault()
    submit()
  })
  document.querySelector('[data-modal-submit]')?.addEventListener('click', submit)
</script>
